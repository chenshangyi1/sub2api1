# Package the verified executable as an unused candidate; inherit runtime config.
ARG BASE_IMAGE
FROM ${BASE_IMAGE}
ARG SOURCE_REVISION
ARG BINARY_SHA256
ARG BASE_IMAGE_ID
LABEL org.opencontainers.image.revision="${SOURCE_REVISION}" \
      xyz.xinmc.binary-sha256="${BINARY_SHA256}" \
      xyz.xinmc.base-image-id="${BASE_IMAGE_ID}"
COPY --chmod=755 outputs/claude-jws-candidate/sub2api /app/sub2api
